    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/howler": "^2.2.12",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-lazyload": "^3.2.3",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "msw": "^2.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.8.0"
  }
}
